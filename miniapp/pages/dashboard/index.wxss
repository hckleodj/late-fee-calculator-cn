.summary-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; margin-bottom: 24rpx; }
.summary-item { background: #eef5fb; color: #245785; text-align: center; border-radius: 18rpx; padding: 22rpx 8rpx; font-size: 22rpx; }
.summary-item text { display: block; font-size: 42rpx; font-weight: 700; }
.summary-item.danger { background: #fff0ec; color: #a23a29; }
.summary-item.warning { background: #fff7e8; color: #9a5b0a; }
.reminder { padding: 22rpx 0; border-bottom: 1rpx solid #d6e0e8; }
.reminder:last-child { border-bottom: 0; }
.name { font-size: 30rpx; font-weight: 700; }
.amount-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-top: 18rpx; }
.amount-grid view { background: #f8fafb; border-radius: 12rpx; padding: 14rpx 8rpx; text-align: center; }
.amount-grid text, .amount-grid strong { display: block; }
.amount-grid text { color: #637786; font-size: 20rpx; }
.amount-grid strong { margin-top: 6rpx; font-size: 23rpx; }
