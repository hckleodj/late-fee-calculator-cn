.line { margin-top: 18rpx; }
.migration-text { margin-top: 20rpx; }
.preview-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10rpx; text-align: center; }
.preview-grid view { background: #eef5fb; border-radius: 12rpx; padding: 16rpx 6rpx; }
.preview-grid text, .preview-grid strong { display: block; }
.preview-grid text { color: #637786; font-size: 20rpx; }
.preview-grid strong { color: #245785; font-size: 32rpx; margin-top: 5rpx; }
.warning { background: #fff7e8; color: #9a5b0a; border-radius: 12rpx; padding: 16rpx; margin-top: 14rpx; }
.safety { border-color: #e8cf91; background: #fff9e8; }
