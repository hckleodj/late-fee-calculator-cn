page { background: #f4f7f9; color: #17212b; font-size: 28rpx; }
.page { padding: 28rpx; }
.hero { background: #245785; color: #fff; border-radius: 24rpx; padding: 34rpx; margin-bottom: 24rpx; }
.hero-title { font-size: 42rpx; font-weight: 700; }
.hero-subtitle { margin-top: 10rpx; opacity: .86; font-size: 24rpx; }
.card { background: #fff; border: 1rpx solid #d6e0e8; border-radius: 22rpx; padding: 28rpx; margin-bottom: 22rpx; box-shadow: 0 10rpx 36rpx rgba(22,52,77,.06); }
.card-title { font-size: 32rpx; font-weight: 700; margin-bottom: 18rpx; }
.muted { color: #637786; font-size: 24rpx; line-height: 1.55; }
.money { color: #245785; font-weight: 700; }
.danger-text { color: #a23a29; }
.warning-text { color: #9a5b0a; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.stack { display: flex; flex-direction: column; gap: 16rpx; }
.field { margin-bottom: 22rpx; }
.label { display: block; margin-bottom: 10rpx; font-weight: 600; }
.input, .textarea, .picker { width: 100%; box-sizing: border-box; border: 1rpx solid #b8c7d3; border-radius: 14rpx; background: #fff8d9; padding: 0 20rpx; }
.input, .picker { height: 88rpx; line-height: 88rpx; }
.textarea { min-height: 220rpx; padding-top: 18rpx; background: #fff; }
.button { margin-top: 18rpx; background: #287a4b; color: #fff; border-radius: 16rpx; font-size: 30rpx; font-weight: 700; }
.button.secondary { background: #e9f1f6; color: #245785; }
.button.danger { background: #fff0ec; color: #a23a29; }
.button.mini { margin: 0; width: auto; height: 68rpx; line-height: 68rpx; padding: 0 22rpx; font-size: 24rpx; }
.badge { display: inline-flex; align-items: center; border-radius: 999rpx; padding: 8rpx 16rpx; background: #eef5fb; color: #245785; font-size: 22rpx; font-weight: 700; }
.empty { text-align: center; color: #637786; padding: 48rpx 20rpx; }
.divider { height: 1rpx; background: #d6e0e8; margin: 24rpx 0; }
.error { background: #fff0ec; color: #a23a29; padding: 18rpx; border-radius: 14rpx; margin-bottom: 20rpx; }
.success { background: #e9f6ef; color: #287a4b; padding: 18rpx; border-radius: 14rpx; margin-bottom: 20rpx; }
.loading { text-align: center; color: #637786; padding: 60rpx; }
